        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Diabetes&quot; THEN [Diabetes_AdjPrev]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Obesity&quot; THEN [Obesity_AdjPrev]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;High Blood Pressure&quot; THEN [BPHIGH_AdjPrev]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Mental Health (Poor Days)&quot; THEN [MHLTH_AdjPrev]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Sleep Less Than 7h&quot; THEN [SLEEP_AdjPrev]&#10;END' />
      </column>
      <column caption='Health burden index' datatype='real' name='[Calculation_2774409925226496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Diabetes_AdjPrev] + [Obesity_AdjPrev] +&#10;[BPHIGH_AdjPrev] + [MHLTH_AdjPrev] +&#10;[SLEEP_AdjPrev]) / 5' />
      </column>
      <column caption='Cumulative %' datatype='real' name='[Calculation_2774409934004225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Diabetes_AdjPrev])) /&#10;TOTAL(SUM([Diabetes_AdjPrev]))'>
